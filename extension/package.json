{
  "name": "auto-doc-agent",
  "displayName": "Auto-Doc Agent",
  "description": "AI-powered automatic documentation generator — generates hover tooltips as you write code",
  "version": "0.1.0",
  "publisher": "JohnyJames",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnyJames9496/auto-doc-agent"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["documentation", "AI", "autocomplete", "hover", "python"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Auto-Doc Agent",
      "properties": {
        "autoDocAgent.apiUrl": {
          "type": "string",
          "default": "https://auto-doc-agent.onrender.com",
          "description": "Backend API URL"
        },
        "autoDocAgent.jwtToken": {
          "type": "string",
          "default": "",
          "description": "JWT authentication token from auto-doc-agent.onrender.com/api/docs"
        },
        "autoDocAgent.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic documentation generation"
        },
        "autoDocAgent.debounceMs": {
          "type": "number",
          "default": 3000,
          "description": "Milliseconds to wait after typing stops"
        }
      }
    },
    "commands": [
      {
        "command": "autoDocAgent.generateNow",
        "title": "Auto-Doc: Generate Documentation Now"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "axios": "^1.7.0"
  }
}